<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. 다크 테마는 별도 대응 범위 밖이라 라이트 테마와 동일한 브랜드 컬러를 사용한다. -->
    <style name="Theme.ModuMessenger" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_violet</item>
        <item name="colorPrimaryVariant">@color/brand_violet_dark</item>
        <item name="colorOnPrimary">@color/on_brand_violet</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorSecondaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnSecondary">@color/on_brand_blue</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
