<?xml version="1.0" encoding="utf-8"?>
<!-- 프로필 보기. 내 프로필과 친구 프로필이 같은 레이아웃을 쓴다.
     내 프로필일 때만 [프로필 편집] 이 보이고, 친구일 때는 GONE 이라 [채팅 하기] 가 폭을 다 쓴다. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface">

    <!-- 작은 화면에서 잘리지 않도록 감싼다. 내용이 화면보다 짧으면 스크롤이 잡히지 않아
         배경사진의 아래로 쓸어 닫기 제스처가 그대로 동작한다. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/profile_wallpaper_image"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:background="@color/brand_violet"
                android:contentDescription="배경 사진"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <View
                android:id="@+id/profile_wallpaper_scrim"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:background="@drawable/profile_top_scrim"
                app:layout_constraintEnd_toEndOf="@+id/profile_wallpaper_image"
                app:layout_constraintStart_toStartOf="@+id/profile_wallpaper_image"
                app:layout_constraintTop_toTopOf="@+id/profile_wallpaper_image" />

            <!-- 위·아래 제약을 둘 다 배경사진의 아래 선에 걸어 그 선 위에 반씩 걸치게 한다.
                 음수 마진을 쓰지 않으므로 화면 크기가 달라져도 위치가 흔들리지 않는다. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile_activity_image"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="프로필 사진"
                android:padding="4dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/profile_wallpaper_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_wallpaper_image"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Modu.Circle"
                app:strokeColor="@color/white"
                app:strokeWidth="4dp"
                tools:srcCompat="@tools:sample/avatars" />

            <TextView
                android:id="@+id/profile_activity_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="이름"
                android:textColor="@color/on_chat_bubble"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_activity_image" />

            <!-- 자르기는 뷰에 맡긴다. 자바에서 15자에서 잘라 붙이던 말줄임을 없앴다. -->
            <TextView
                android:id="@+id/profile_activity_status_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="32dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="상태 메세지"
                android:textColor="@color/grey"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_activity_username" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_edit_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="8dp"
                android:text="프로필 편집"
                android:textColor="@color/brand_violet"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toStartOf="@+id/start_chat_button"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_activity_status_message"
                app:strokeColor="@color/brand_violet" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_chat_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@color/brand_violet"
                android:text="채팅 하기"
                android:textColor="@color/on_brand_violet"
                app:cornerRadius="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/profile_edit_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/profile_edit_button"
                app:layout_goneMarginStart="16dp"
                app:layout_constraintTop_toTopOf="@+id/profile_edit_button" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/profile_image_history_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/circle_icon_button_scrim"
        android:contentDescription="프로필 사진 기록"
        android:padding="8dp"
        android:src="@drawable/ic_baseline_image_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/profile_close_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/circle_icon_button_scrim"
        android:contentDescription="닫기"
        android:padding="8dp"
        android:src="@drawable/ic_baseline_clear_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
