<?xml version="1.0" encoding="utf-8"?>
<!-- 채팅방 정보 수정. 프로필 보기·수정 화면과 같은 뼈대를 쓴다.
     배너 → 배너에 반씩 걸친 원형 사진 → 라벨 붙은 입력 칸 → 하단 고정 저장 버튼. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/chat_room_edit_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/chat_room_save_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- 방에는 프로필 같은 배경사진이 없어 브랜드색으로 깐다. -->
            <View
                android:id="@+id/chat_room_banner"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:background="@color/brand_violet"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/chat_room_banner_scrim"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:background="@drawable/profile_top_scrim"
                app:layout_constraintEnd_toEndOf="@+id/chat_room_banner"
                app:layout_constraintStart_toStartOf="@+id/chat_room_banner"
                app:layout_constraintTop_toTopOf="@+id/chat_room_banner" />

            <!-- 위·아래 제약을 둘 다 배너의 아래 선에 걸어 그 선에 반씩 걸치게 한다.
                 테두리가 잘리지 않도록 테두리 굵기만큼 패딩을 준다. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_room_image"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="채팅방 사진"
                android:padding="4dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/chat_room_banner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chat_room_banner"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Modu.Circle"
                app:strokeColor="@color/white"
                app:strokeWidth="4dp"
                tools:srcCompat="@tools:sample/avatars" />

            <ImageButton
                android:id="@+id/chat_room_image_change_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_icon_button"
                android:contentDescription="채팅방 사진 바꾸기"
                android:padding="7dp"
                android:src="@drawable/ic_baseline_photo_camera_24"
                app:layout_constraintBottom_toBottomOf="@+id/chat_room_image"
                app:layout_constraintEnd_toEndOf="@+id/chat_room_image"
                app:tint="@color/brand_violet" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/chat_room_name_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:hint="채팅방 이름"
                app:boxStrokeColor="@color/brand_violet"
                app:hintTextColor="@color/brand_violet"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chat_room_image">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/chat_room_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/on_chat_bubble" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/chat_room_name_help"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:text="이름을 비워 두면 참여자 이름으로 표시됩니다."
                android:textColor="@color/grey"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chat_room_name_layout" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chat_room_save_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/brand_violet"
        android:text="저장"
        android:textColor="@color/on_brand_violet"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/chat_room_edit_close_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/circle_icon_button_scrim"
        android:contentDescription="닫기"
        android:padding="8dp"
        android:src="@drawable/ic_baseline_clear_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
